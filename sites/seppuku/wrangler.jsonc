{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "seppuku-site",
  "main": "../shared/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "/" と "/index.html" は Worker を通し、言語の自動選択用のヒントを HTML に埋め込む
    "run_worker_first": ["/x/*", "/", "/index.html"],
    "not_found_handling": "404-page"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.client.js"], "fallthrough": false }],
  "vars": {
    "SITE": "seppuku",
    // 開発中は日本語に固定する。テスト・公開の前に、この行を消す
    // （残したままだと npm run deploy:seppuku が止まるようにしてある）
    "FORCE_LANG": "ja"
  },
  // 全コインのサイトで1つのデータベースを共有する（site 列で区別）
  // database_id は `npx wrangler d1 create meme-analytics` の出力で置き換える
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meme-analytics",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],
  "observability": { "enabled": true }
}
