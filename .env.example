# ===== トークン設定 =====
TOKEN_NAME="Seppuku"
TOKEN_SYMBOL="SEPPUKU"
# 発行枚数（小数点なしの枚数。18桁の decimals はスクリプト側で自動付与）
TOTAL_SUPPLY=1000000000

# ===== 配分（%、合計100） =====
LIQUIDITY_PCT=90
TEAM_PCT=5
COMMUNITY_PCT=5

# ===== ウォレット =====
# チーム分の受取人（ハードウェアウォレット or Safe マルチシグ推奨。後から変更不可）
TEAM_WALLET=0x0000000000000000000000000000000000000000
# エアドロップ・マーケ用
COMMUNITY_WALLET=0x0000000000000000000000000000000000000000

# ===== 半減期ベスティング =====
# 最初の解放までの日数 / 半減期の間隔（日） / 何回で全量解放するか
VESTING_CLIFF_DAYS=90
VESTING_PERIOD_DAYS=180
VESTING_HALVINGS=8

# ===== RPC / API =====
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=
