# 全コイン共通の秘密情報（.env にコピーして記入。.env は Git の対象外）
# forge はプロジェクト直下の .env を自動で読み込みます。
# コインごとの名前・配分などは coins/<コイン名>/coin.env に書きます。

BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# 任意。空なら Blockscout で検証する（Etherscan の API は Base が有料プラン専用）
ETHERSCAN_API_KEY=

# cast wallet import で登録したキーストア名
DEPLOYER_ACCOUNT=deployer
