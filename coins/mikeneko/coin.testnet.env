# テストネット（Base Sepolia）用の上書き設定。./deploy.sh <coin> base_sepolia のときだけ coin.env の後に読み込まれる。
# 半減期を短くして、解放の動きを数時間で確かめる：1時間後に 50%、以後1時間ごとに半減、4回目（3時間後）で全量。
VESTING_CLIFF_SECONDS=3600
VESTING_PERIOD_SECONDS=3600
VESTING_HALVINGS=4

# 両側（full）で試すときに入れる ETH の量（片側＝single では使わない）
LIQUIDITY_ETH=0.02

# テストネット用のウォレット：本番と同じ二人の受け取り用（金庫）とコミュニティ用を使う（本番前のリハーサル）
# 以前の 1・2 回目のテストネットでは、MetaMask の Account1（木村）・Account3（鳥間さんの代わり）・Account4（コミュニティ）を使った
TEAM_WALLETS=0xA9564c7546E48354Ce7C3479f6d637c445F94418,0xF1c19116E36505145723eAf7C3D096Dd20FDC2b2
COMMUNITY_WALLET=0x1D1599615F005A385dD451CEf81A7D99810c98e6
LP_RECIPIENTS=0xA9564c7546E48354Ce7C3479f6d637c445F94418,0xF1c19116E36505145723eAf7C3D096Dd20FDC2b2
