# テストネット（Base Sepolia）用の上書き設定。./deploy.sh seppuku base_sepolia のときだけ coin.env の後に読み込まれる。
# 半減期を短くして、解放の動きを数時間で確かめる：1時間後に 50%、以後1時間ごとに半減、4回目（3時間後）で全量。
VESTING_CLIFF_SECONDS=3600
VESTING_PERIOD_SECONDS=3600
VESTING_HALVINGS=4

# 両側（full）で試すときに入れる ETH の量（片側＝single では使わない）
LIQUIDITY_ETH=0.02

# テストネット用のウォレット（MetaMask の Account1 = 木村、Account3 = 鳥間さんの代わり、Account4 = コミュニティ）
# 本番では coin.env の値を使う（鳥間さん本人のウォレットができたら差し替える）
TEAM_WALLETS=0x1fE8DB81E607793A24B2e244c3A7e69C3D366035,0xD0ED0ac05D68127aCEF3EC6E2bF8F81572b8041d
COMMUNITY_WALLET=0x078cEc95176084078274FCF6CebD7E729158Bc46
