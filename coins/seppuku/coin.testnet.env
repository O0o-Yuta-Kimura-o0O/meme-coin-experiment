# テストネット（Base Sepolia）用の上書き設定。./deploy.sh seppuku base_sepolia のときだけ coin.env の後に読み込まれる。
# 半減期を短くして、解放の動きを数時間で確かめる：1時間後に 50%、以後1時間ごとに半減、4回目（3時間後）で全量。
VESTING_CLIFF_SECONDS=3600
VESTING_PERIOD_SECONDS=3600
VESTING_HALVINGS=4

# 両側（full）で試すときに入れる ETH の量（片側＝single では使わない）
LIQUIDITY_ETH=0.02

# テストネット用のウォレット：本番と同じ二人の受け取り用（金庫）とコミュニティ用を使う（本番前のリハーサル）
# 以前の 1・2 回目のテストネットでは、MetaMask の Account1（木村）・Account3（鳥間さんの代わり）・Account4（コミュニティ）を使った
TEAM_WALLETS=0xD5c8C0619FdBD39caf0632de238A3A0485eA08Ad,0x6eEb14582921aaF5aaB2ce33D64DAD3B0abcfddc
COMMUNITY_WALLET=0x73da6CF7582226b4289130e734080e4015573Ed2
LP_RECIPIENTS=0xD5c8C0619FdBD39caf0632de238A3A0485eA08Ad,0x6eEb14582921aaF5aaB2ce33D64DAD3B0abcfddc
