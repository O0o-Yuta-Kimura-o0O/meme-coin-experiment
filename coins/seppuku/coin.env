# ===== トークン =====
TOKEN_NAME="SEPPUKU COIN"
TOKEN_SYMBOL="SEPPUKU"
# 発行枚数（小数点なしの枚数。decimals 18 はスクリプト側で付与）
TOTAL_SUPPLY=1000000000

# ===== 配分（%、合計100） =====
# 整数のみ。比較したい要素以外は、ほかのコインとそろえる（research/README.md 参照）
LIQUIDITY_PCT=90
TEAM_PCT=5
COMMUNITY_PCT=5

# ===== ウォレット（公開アドレスのみ。秘密鍵は書かない） =====
# チーム分の受取人（カンマ区切り）。人数で均等に分け、一人ずつ別の半減期ロックを作る。後から変更不可
# Team SEPPUKU：1人目 = 木村 祐太、2人目 = 鳥間 勇（2.5% ずつ）。本番はハードウェアウォレット推奨
TEAM_WALLETS=0xD5c8C0619FdBD39caf0632de238A3A0485eA08Ad,0x6eEb14582921aaF5aaB2ce33D64DAD3B0abcfddc
COMMUNITY_WALLET=0x73da6CF7582226b4289130e734080e4015573Ed2

# ===== 半減期ベスティング =====
VESTING_CLIFF_DAYS=90
VESTING_PERIOD_DAYS=180
VESTING_HALVINGS=8

# ===== 流動性（./add-liquidity.sh で使う） =====
# single = 片側流動性（ETH を入れず、トークンだけで開始価格より上に置く。価格は開始価格より下がらない）
# full   = 両側・フルレンジ（トークンと LIQUIDITY_ETH の ETH を入れる）
LIQUIDITY_MODE=single
# 片側流動性の開始時の時価総額（FDV、ETH 建て）。開始価格 = これ ÷ 発行枚数。比較実験では全コインで同じ値にそろえる
START_FDV_ETH=10
# 両側（full）のときにプールに入れる ETH の量
LIQUIDITY_ETH=1
# LP ポジション（NFT）の受取人（カンマ区切り）。人数で均等に分け、同じ価格帯のポジションを人数分作る。
# 買い手が払う ETH も取引手数料も、取引のたびに均等にたまる。空ならデプロイしたウォレット 1 つ
# Team SEPPUKU：1人目 = 木村 祐太、2人目 = 鳥間 勇（本番はハードウェアウォレット推奨）
LP_RECIPIENTS=0xD5c8C0619FdBD39caf0632de238A3A0485eA08Ad,0x6eEb14582921aaF5aaB2ce33D64DAD3B0abcfddc
# permanent = 作ったポジションを PermanentLPLock に預けて永久にロックする（元本は誰も引き出せず、手数料だけ受取人に届く）
# none      = ポジションを受取人に直接渡す（ロックしない）
LP_LOCK=permanent
