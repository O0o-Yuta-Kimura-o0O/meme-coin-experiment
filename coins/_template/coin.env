# ===== トークン =====
TOKEN_NAME="Template Coin"
TOKEN_SYMBOL="TEMPLATE"
# 発行枚数（小数点なしの枚数。decimals 18 はスクリプト側で付与）
TOTAL_SUPPLY=1000000000

# ===== 配分（%、合計100） =====
# 整数のみ。比較したい要素以外は、ほかのコインとそろえる（research/README.md 参照）
LIQUIDITY_PCT=90
TEAM_PCT=5
COMMUNITY_PCT=5

# ===== ウォレット（公開アドレスのみ。秘密鍵は書かない） =====
# チーム分の受取人。後から変更不可。ハードウェアウォレットか Safe 推奨
TEAM_WALLET=0x0000000000000000000000000000000000000000
COMMUNITY_WALLET=0x0000000000000000000000000000000000000000

# ===== 半減期ベスティング =====
VESTING_CLIFF_DAYS=90
VESTING_PERIOD_DAYS=180
VESTING_HALVINGS=8

# ===== 流動性（./add-liquidity.sh で使う） =====
# プールに入れる ETH の量。比較実験では全コインで同じ値にそろえる
LIQUIDITY_ETH=1
# LP ポジション（NFT）の受取人。空ならデプロイしたウォレット。ロックする前提
LP_RECIPIENT=
